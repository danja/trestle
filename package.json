    "evb": "^0.7.2",
    "loglevel": "^1.8.1",
    "marked": "^5.0.0",
    "rdf-ext": "^2.2.0"
  },
  "devDependencies": {
    "@vitest/ui": "^1.0.0",
    "chai": "^4.5.0",
    "jsdoc": "^4.0.2",
    "jsdom": "^24.0.0",
    "vitest": "^1.0.0",
    "vite": "^5.1.4"
  }
